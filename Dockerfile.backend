FROM node:22-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    VIRTUAL_ENV=/opt/venv

ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "$VIRTUAL_ENV"

COPY backend ./backend
COPY frontend ./frontend
COPY ABS_DataAPI.openapi.yaml ABS_DataAPI.openapi.yaml
COPY MANUAL_SOURCE_DEFINITIONS.json MANUAL_SOURCE_DEFINITIONS.json
COPY COMTRADE_METADATA.json COMTRADE_METADATA.json
COPY MCP_ANALYST.md MCP_ANALYST.md
COPY WEB_APP.md WEB_APP.md
COPY UNIFIED_CATALOG_FULL.json UNIFIED_CATALOG_FULL.json
COPY scripts ./scripts

RUN mkdir -p /app/runtime /app/cache \
    && pip install --no-cache-dir -r backend/requirements.txt \
    && npm --prefix frontend ci \
    && npm --prefix frontend run build \
    && rm -rf frontend/node_modules /root/.npm

EXPOSE 8080

CMD ["/opt/venv/bin/python", "-m", "backend.app.serve", "--host", "0.0.0.0", "--port", "8080"]
